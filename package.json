{
  "name": "bug2pr",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a screen recording of a web bug into a reproduced failing test and a verified pull request, powered by Meta Muse models.",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixture:record": "tsx scripts/record-fixture-bug-video.ts",
    "smoke:video": "tsx scripts/smoke/smoke-video-understanding.ts",
    "smoke:computer-use": "tsx scripts/smoke/smoke-computer-use.ts",
    "smoke:sam": "tsx scripts/smoke/smoke-sam-video-segmentation.ts",
    "eval:record": "tsx scripts/record-eval-bug-videos.ts",
    "eval:gold": "playwright test -c playwright.eval.config.ts",
    "eval:extract": "tsx scripts/eval-extraction.ts",
    "eval:replay": "tsx scripts/eval-replay.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "dotenv": "^18.0.9",
    "openai": "^7.45.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
