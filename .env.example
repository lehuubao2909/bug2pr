# Meta Model API key from dev.meta.ai (never commit the real .env)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Model ids (override to compare models)
META_VIDEO_MODEL=muse-spark-1.3
# muse-wonder-1.0 currently rejects the computer tool (400), so default to Spark 1.3
META_COMPUTER_USE_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
# Code reasoning (bug localization + fix loop) on the Meta Model API
META_FIX_MODEL=muse-wonder-1.0

# Private mode: run localization + fix on Meta open weights (Muse Spark Open) via Baseten
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# meta | baseten
FIX_PROVIDER=meta
LOCALIZE_PROVIDER=meta

# Target apps (dev servers must be running with the buggy code checked out)
SHADCN_ADMIN_URL=http://localhost:5173/tasks
ACTUAL_URL=http://localhost:3002/
TARGETS_DIR=../targets
