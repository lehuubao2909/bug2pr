Subject: [PATCH] seed bug: last-page button goes to second-to-last page

---
 src/components/data-table/pagination.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/components/data-table/pagination.tsx b/src/components/data-table/pagination.tsx
index 5e5991b..ef13b51 100644
--- a/src/components/data-table/pagination.tsx
+++ b/src/components/data-table/pagination.tsx
@@ -117,7 +117,7 @@ export function DataTablePagination<TData>({
           <Button
             variant='outline'
             className='size-8 p-0 @max-md/content:hidden'
-            onClick={() => table.setPageIndex(table.getPageCount() - 1)}
+            onClick={() => table.setPageIndex(table.getPageCount() - 2)}
             disabled={!table.getCanNextPage()}
           >
             <span className='sr-only'>Go to last page</span>
